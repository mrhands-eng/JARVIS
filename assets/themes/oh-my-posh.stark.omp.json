{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#00E5FF",
          "template": "JARVIS "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#E8F7FF",
          "properties": { "style": "folder" },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#C9A227",
          "template": "{{ if .Branch }}› {{ .Branch }}{{ end }} "
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#00E5FF",
          "template": "»"
        }
      ]
    }
  ]
}
