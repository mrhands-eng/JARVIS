{
  "name": "stark-os",
  "version": "1.0.0",
  "description": "Stark OS / JARVIS — HUD + voice assistant powered by Cursor Agent SDK",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-msedge-tts.js",
    "build": "tsc && node scripts/copy-static.js",
    "start": "npm run build && node node_modules/electron/cli.js .",
    "dev": "npm run build && node node_modules/electron/cli.js .",
    "apply-visual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-visual.ps1",
    "restore-visual": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-visual.ps1",
    "login": "npm run build && node dist/main/login-cli.js",
    "enable-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/enable-startup.ps1",
    "disable-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/disable-startup.ps1"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.7",
    "msedge-tts": "^2.1.1",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "sharp@0.32.6": true
  }
}
