# Optional if you already ran: npm run login  (stores key in ~/.cursor/sdk/auth.json)
# Get a key from https://cursor.com/dashboard → Integrations / API
CURSOR_API_KEY=

# Optional model id (default: composer-2.5)
STARK_MODEL=composer-2.5

# Voice: default is free Edge neural JARVIS-like (en-GB-RyanNeural / ru-RU-DmitryNeural)
# Optional cinematic upgrade — https://elevenlabs.io
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

